                <mxCell id="legend" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; = Primary Key&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; = Foreign Key&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; = Primary Key + Foreign Key&lt;br&gt;&lt;br&gt;&lt;b&gt;1 : N&lt;/b&gt; = One-to-Many&lt;br&gt;&lt;b&gt;N : M&lt;/b&gt; = Many-to-Many (implemented using junction table)&lt;br&gt;&lt;br&gt;&lt;b&gt;Blue&lt;/b&gt; = Organization&lt;br&gt;&lt;b&gt;Green&lt;/b&gt; = User / Authentication&lt;br&gt;&lt;b&gt;Red&lt;/b&gt; = Authorization / Audit&lt;br&gt;&lt;b&gt;Yellow&lt;/b&gt; = Junction Table&lt;br&gt;&lt;b&gt;Purple&lt;/b&gt; = Permission&lt;br&gt;&lt;br&gt;&lt;b&gt;NULL&lt;/b&gt; = Optional field&lt;br&gt;&lt;b&gt;NOT NULL&lt;/b&gt; = Required field" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;align=left;verticalAlign=top;spacingTop=10;spacingLeft=10;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" parent="1" vertex="1">
